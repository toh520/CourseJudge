# ==============================================================================
# CourseJudge 智能代码判题与教学辅助系统 - 环境变量配置模板 (.env.example)
# 使用说明:
#   1. 复制本文件重命名为 .env: cp .env.example .env
#   2. 在 .env 中填入你的实际大模型 API Key 等私密参数
#   3. .env 文件已在 .gitignore 中忽略，严禁上传至公开 Git 仓库
# ==============================================================================

# --- 大语言模型 (LLM) API 配置 ---
# 支持 DeepSeek / 阿里通义千问 / OpenAI / Kimi 等兼容 OpenAI 协议的模型接口
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# --- 数据库连接配置 ---
# 默认采用项目根目录下的 SQLite 单文件数据库，随拷随跑，开箱即用
DATABASE_URL=sqlite:///./course_judge.db
# 若后续切换局域网/公网 MySQL 共享库，请切换为如下格式并修改密码主机:
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/course_judge?charset=utf8mb4

# --- JWT 令牌与安全加盐密钥 ---
SECRET_KEY=course_judge_super_secret_jwt_key_please_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- 编译器双模探针模式配置 ---
# auto: 优先检测操作系统环境变量 g++，未检测到则使用项目内置绿色版 compiler/bin/g++.exe
# builtin: 强制仅使用项目内置绿色便携版
# system: 强制仅使用操作系统环境已安装的 g++
COMPILER_PROBE_MODE=auto

# --- 判题沙箱资源默认限制 ---
DEFAULT_TIME_LIMIT_MS=1000
DEFAULT_MEMORY_LIMIT_MB=256
